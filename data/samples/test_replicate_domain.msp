# define potential we'll reuse later
lj_compute_force:
  parameters: { epsilon: 9.340E-20 J , sigma: 0.227E-09 m }
  rcut: 5.68 ang

compute_force: lj_compute_force

# atoms descriptions
species:
  - Copper:
      mass: 105.486E-27 kg
      z: 29
      charge: 0 e-

grid_flavor: grid_flavor_minimal

input_data:
  - read_stamp:
      file: small_lattice.mpio
      bounds_mode: COMPUTED
      enlarge_bounds: 1.0 ang
  - replicate_domain: { repeat: [3,3,3] }
  - grid_stats

domain:
  cell_size: 20.0 ang

global:
  simulation_end_iteration: 10
