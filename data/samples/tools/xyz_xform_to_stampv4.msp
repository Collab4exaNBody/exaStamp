includes:
  - config_species.msp

simulation:
  - grid_flavor_multimat
  - global
  - domain
  - generate_default_species
  - input:
    - user_source_file:
        rebind: { text: file }
        body: [ input_text: { mesg: "xyz file : " } ]
    - read_xyz_file_with_xform:
  - reduce_species_after_read
  - user_temperature:
      rebind: { value: init_temperature }
      body: [ input_value: { mesg: "temperature: " } ]
  - do_init_temperature
  - output:
    - user_destination_file:
        rebind: { text: filename }
        body: [ input_text: { mesg: "stampv4 file : " } ]
    - write_stamp_v4:
        dt: 0.0
        timestep: 0


# atoms: set velocities to the temperature given by the user, if positive
do_init_temperature:
  - block1:
      rebind: { value: init_temperature, result: enable_init_temperature }
      body:
        - greater_than: { threshold: 0.0 K }
  - block3:
      condition: enable_init_temperature
      rebind: { T: init_temperature }
      body:
        - message: "Initialize temperature"
        - init_temperature
