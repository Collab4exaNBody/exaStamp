
domain:
  cell_size: 2.0 ang

global:
  ghost_dist: 0.0 ang

simulation:
  - grid_flavor_multimat
  - global
  - domain
  - species
  - input:
    - user_source_file:
        rebind: { text: file }
        body: [ input_text: { mesg: "xyz file : " } ]
    - read_xyz_file:
        bounds_mode: FILE
  - reduce_species
  - user_temperature:
      rebind: { value: init_temperature }
      body: [ input_value: { mesg: "temperature: " } ]
  - do_init_temperature
  - simple_cost_model: { cost_model_coefs: [ 0.003, 0.0, 4.0, 1.0 ] }   # X^3, X^2, X, constant (X: particle density)
  - load_balance_rcb
  - migrate_cell_particles
  - simulation_thermodynamic_state
  - print_thermodynamic_state
  - write_stamp_v4:
      filename: output.StampV4
      dt: 0.0
      timestep: 0


# atoms: set velocities to the temperature given by the user, if positive
do_init_temperature:
  - block1:
      rebind: { value: init_temperature, result: enable_init_temperature }
      body:
        - greater_than: { threshold: 0.0 K }
  - block3:
      condition: enable_init_temperature
      rebind: { T: init_temperature }
      body:
        - message: "Initialize temperature"
        - init_temperature
