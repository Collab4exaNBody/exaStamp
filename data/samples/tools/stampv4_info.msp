includes:
  - config_species.msp

domain:
  cell_size: 40.0 ang

global:
  ghost_dist: 0.0 ang
  grid_subdiv: 3

# allows for easy override from commande line
read_stamp_v4:
  bounds_mode: FILE
  enable_xform_scale: true
  pbc_adjust_xform: true
  enlarge_bounds: 0.0 ang

simulation:
  - mpi_comm_world
  - grid_flavor_multimat
  - global
  - domain
  - generate_default_species
  - read_stamp_v4
  - reduce_species
  - simple_cost_model: { cost_model_coefs: [ 0.003, 0.0, 4.0, 1.0 ] }   # X^3, X^2, X, constant (X: particle density)
  - load_balance_rcb
  - migrate_cell_particles
  - simulation_thermodynamic_state
  - print_thermodynamic_state
  - print_domain
  - grid_stats
  - chunk_neighbors_stats
  - memory_stats

