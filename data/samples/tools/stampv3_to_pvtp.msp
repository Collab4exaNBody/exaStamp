includes:
  - config_species.msp

domain:
  cell_size: 40.0 ang

global:
  ghost_dist: 0.0 ang
#  grid_subdiv: 3

simulation:
  - mpi_comm_world
  - grid_flavor_multimat
  - global
  - domain
  - species
  - input_mpio_file:
    - user_source_file:
        rebind: { text: file }
        body: [ input_text: { mesg: "input file :\n" } ]
    - read_stamp_v3:
        bounds_mode: FILE
  - reduce_species
  - simple_cost_model: { cost_model_coefs: [ 0.003, 0.0, 4.0, 1.0 ] }   # X^3, X^2, X, constant (X: particle density)
  - load_balance_rcb
  - migrate_cell_particles
  - simulation_thermodynamic_state
  - print_thermodynamic_state
  - timestep_file: "particles_%09d"
  - write_paraview

