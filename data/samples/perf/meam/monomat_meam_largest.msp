includes:
  - monomat_meam.msp

configuration:
  profiling:
    exectime: true
#  debug:
#    graph: true
#    graph_lod: 0

load_balance:
  - simple_cost_model: { cost_model_coefs: [ 0.0, 0.0, 4.0, 1.0 ] }   # X^3, X^2, X, constant (X: particle density)
  - load_balance_rcb

rebuild_amr:
  sub_grid_density: 5.0

global:
  simulation_end_iteration: 60004
  #amr_z_curve: false

update_particle_neighbors:
  - amr_grid_pairs
  - chunk_neighbors
#  - chunk_neighbors_stats

+input_data:
  - grid_stats
  - replicate_domain: [ 1 , 7 , 7 ]
  - grid_stats
