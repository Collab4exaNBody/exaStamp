units           metal
atom_style      atomic
boundary        p p p

read_data       Fe_disturbed.lmp  

pair_style      eam/alloy
pair_coeff      * * Fe_Olsson_CMS2009.eam.alloy Fe

neighbor        2.0 bin
neigh_modify    every 5 delay 0 check yes

fix             1 all nve

fix             twotemp all ttm/grid 342785 1.2470e-5 0.087614 &
                0.005365 29.5917 47.5679 58.4613 10 10 10 set 1800.0

compute         pe all pe/atom
compute         ke all ke/atom

timestep        0.0001
thermo          1

thermo_style    custom step temp etotal pe f_twotemp[1] f_twotemp[2]
                thermo_modify format float "%20.16g"

run             1000
