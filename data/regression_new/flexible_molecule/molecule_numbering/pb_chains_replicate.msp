# Molecule numbering after replication : the 20 polybutadiene chains are replicated 2x1x1 by replicate_molecule_domain
# (config_molecule.msp), which unfolds them, replicates them and renumbers molecules. Replicas get new atom ids, so
# there must be 40 distinct molecules, also after a later molecule_numbering. molecule_check_numbering stops with an
# error if the numbering is wrong.
includes:
  - config_molecule.msp

replicate_domain_cmol:
  repeat: [ 2 , 1 , 1 ]

setup_system:
  - domain:
      cell_size: 5.0 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_fatomes_mol:
      filename: "FAtomes_pb_chains"
      stampinput: "DONNEES_pb_condensed"
  - replicate_molecule_domain

check_pb_chains_numbering:
  - molecule_check_numbering: { expected_molecules: 40 }

simulation_epilog:
  - check_pb_chains_numbering
  - molecule_numbering
  - check_pb_chains_numbering

global:
  dt: 1.0 fs
  rcut_inc: 2.0 ang
  max_iteration: 5
  simulation_thermostate_screen_frequency: 5
  simulation_snapshot_frequency: -1
  simulation_restart_frequency: -1
