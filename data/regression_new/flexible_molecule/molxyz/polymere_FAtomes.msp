# Polymer (24696 atoms, molecule_polymere.FAtomes in the exaStamp data directory) read with read_fatomes_mol and
# replicated 2x1x1 by replicate_molecule_domain (config_molecule.msp), 10 steps.
includes:
  - config_molecule.msp

replicate_domain_cmol:
  repeat: [ 2 , 1 , 1 ]

setup_system:
  - domain:
      cell_size: 8. ang
      periodic: [ true, true, true ]
      expandable: false
  - read_fatomes_mol:
      filename: molecule_polymere.FAtomes
      stampinput: molecule_polymere.init
  - replicate_molecule_domain

simulation_epilog:
  - force_thermo_state
  - compute_all_forces_energy
  - default_thermostate_compute
  - check_values: { file: polymere_FAtomes.dat , samples: 256 , pos_threshold: 1.e-10 , vel_threshold: 1.e-10 , acc_threshold: 1.e-7 }

global:
  dt: 0.1 fs
  rcut_inc: 4.0 ang
  max_iteration: 10
  simulation_thermostate_screen_frequency: 5
  simulation_snapshot_frequency: -1
  simulation_restart_frequency: -1
