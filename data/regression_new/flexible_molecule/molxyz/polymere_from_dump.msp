# Polymer (24696 atoms) read from a molecule dump (molecule_polymere_dump.MpiIO in the exaStamp data directory, written
# from molecule_polymere.FAtomes : the dump holds the force field), cell size scaled by 2, replicated 2x1x1 by
# replicate_molecule_domain (config_molecule.msp), 12 steps.
includes:
  - config_molecule.msp

replicate_domain_cmol:
  repeat: [ 2 , 1 , 1 ]

setup_system:
  - read_dump_molecule:
      filename: molecule_polymere_dump.MpiIO
      scale_cell_size: 2.0
  - replicate_molecule_domain

simulation_epilog:
  - force_thermo_state
  - compute_all_forces_energy
  - default_thermostate_compute
  - check_values: { file: polymere_from_dump.dat , samples: 256 , pos_threshold: 1.e-10 , vel_threshold: 1.e-10 , acc_threshold: 1.e-7 }

global:
  dt: 0.1 fs
  rcut_inc: 4.0 ang
  max_iteration: 12
  simulation_thermostate_screen_frequency: 6
  simulation_snapshot_frequency: -1
  simulation_restart_frequency: -1
