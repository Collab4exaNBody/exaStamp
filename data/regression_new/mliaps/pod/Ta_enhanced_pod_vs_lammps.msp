# enable-if-EXASTAMP_MLIP_POD_BUILD
configuration:
  profiling:
    summary: true
# Zero force and energy everywhere and in the ghosts as well
compute_force_prolog:
  - zero_force_energy: { ghost: true }

# Update forces of non-ghost particles from their ghosts before pushing total force to acceleration
compute_force_epilog:
  - update_force_energy_from_ghost
  - force_to_accel

species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

init_parameters:
  - species
  - pod_init:
      parameters:
        pod_file: "Ta_param_enhanced.pod"
        coeff_file: "Ta_coefficients_enhanced.pod"

compute_force:
  - pod_force

# Enhanced POD (Ta_param_enhanced.pod: rin, fade-in, scaled LJ) on the configuration in.enhanced_pod uses (Ta_disturbed.lmp),
# for a direct step-by-step ground-truth comparison -- see Ta_pod.msp for the normal
# random-lattice/finite-temperature MD test (Ta_enhanced_pod.msp for the enhanced potential).
setup_system:
  - domain:
      cell_size: 6.6 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "Ta_disturbed.xyz"

numerical_scheme: verlet_nve

global:
  max_iteration: 10
  simulation_thermostate_screen_frequency: 1
  simulation_thermostate_file_frequency: 1
  simulation_snapshot_frequency: -1
  rcut_inc: 1.0 ang
  dt: 0.005 ps
  force_flush_file: true
