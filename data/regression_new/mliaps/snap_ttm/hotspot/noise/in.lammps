# Te-dependent SNAP + fix ttm, local hot spot, FULL Langevin coupling with noise (LAMMPS example parameters),
# uniform initial Te = 1 eV. Stochastic: statistical comparison only. Needs the fix ttm pre_force patch.
variable nsteps index 1000
units           metal
boundary        p p p
lattice         fcc 4.078
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box
mass            1 196.9665

#              seed   C_e       rho_e    kappa_e   gamma_p gamma_s v_0     Nx Ny Nz
fix twotemp all ttm 342785 1.2470e-5 0.087614 0.0005365 29.5917 47.5679 58.4613 6  6  6 set 11604.518121550082

pair_style hybrid/overlay zbl 2.0 3.5 snap_ttm
pair_coeff 1 1 zbl 79 79
pair_coeff * * snap_ttm dir.inputs/Au.snapcoeff dir.inputs/Au.snapparam dir.inputs/Au.snapbetas Au f_twotemp

compute avgte all reduce ave f_twotemp
thermo          10
thermo_style    custom step temp pe ke etotal press c_avgte f_twotemp[1] f_twotemp[2]
thermo_modify   norm yes format float %.16g

timestep 1.0e-3
neighbor 1.0 bin
neigh_modify once no every 1 delay 0 check yes

# local initial ionic temperature: 3000 K sphere (r = 6 ang) at the box center, 300 K elsewhere
region          hot sphere 12.234 12.234 12.234 6.0 units box
group           hot region hot
group           cold subtract all hot
displace_atoms all move 0.1 0.07 0.05 units box   # perfect fcc atoms sit exactly on cell faces: move them off (tie-break)
velocity cold create 300.0 3423 dist gaussian
velocity hot create 3000.0 4928459 dist gaussian
write_dump all custom init.dump id type x y z vx vy vz modify sort id format float %.17g
fix 1 all nve
run             ${nsteps}
