# exaStamp counterpart of in.lammps: Te-dependent SNAP (snap_ttm_coefficients) + TTM (ionic_eletronic_heat_transfer),
# deterministic variant (no Langevin coupling, Te evolves by diffusion only). init.xyz from init.dump via ../../snap/lmp2xyz.py
includes:
  - config_update_symmetric_forces.msp

# config_update_symmetric_forces' update_force_energy_from_ghost also SUMS the ghost grid_cell_values into
# their owner cells (UpdateGridCellValues=true): with periodic images that multiplies Te by the number of
# images every step. The _no_gcv variant only folds back forces/energies.
compute_force_epilog:
  - update_force_energy_from_ghost_no_gcv
  - force_to_accel

configuration:
  profiling:
    summary: false

species:
  - Au: { mass: 196.9665 Da , z: 79 , charge: 0.0 e- }
zbl_multi_force:
  rcut: 3.5 ang
  parameters:
    - { type_a: Au , type_b: Au , rcut: 3.5 ang , parameters: { r1: 2.0 ang , rc: 3.5 ang } }
compute_force:
  - zbl_multi_force
  # Te of the subcell holding each particle -> per-particle SNAP coefficients (Te after the previous step's TTM update)
  - snap_ttm_coefficients:
      betas_file: "dir.inputs/Au.snapbetas"
  - snap_force_fp64:
      parameters:
        nt: 1
        param: "dir.inputs/Au.snapparam"
        coef:  "dir.inputs/Au.snapcoeff"
  - ghost_update_r_v
  # LAMMPS: fix ttm 342785 1.2470e-5 0.087614 0.0005365 1e-50 0.0 58.4613 4 4 4 (gamma_p 1e-50 there because LAMMPS needs > 0)
  - ionic_eletronic_heat_transfer:
      gamma_p: 0.0 Da/ps
      gamma_s: 0.0 Da/ps
      v_0: 58.4613 ang/ps
      Ke: 0.0005365 eV/ps/ang/K
      Ce: 1.2470e-5 eV/K
      rho_e: 0.087614 1/ang^3
      splat_size: 0.1 ang
      grid_subdiv: 4
      ti_source: "null"
      te_source: "null"
      substep_diffusion: true

grid_flavor: grid_flavor_full

setup_system:
  - domain:
      cell_size: 4.0779999 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "init.xyz"
      bounds_mode: FILE
      read_velocities: true
  - resize_grid_cell_values
  - init_ttm:
      grid_subdiv: 4
      ti_source: "null"
      # Te(x) = s*x + D (K, x in ang), amplitude 0 -> linear. s = K/4.078, D = K, K = 1 eV in K:
      # cell centers 1.5/2.5/3.5/4.5 eV, same values as ttm_grid.in
      te_source:
        wavefront:
          plane: [ 2845.641247220625, 0.0, 0.0, 11604.525006165708 ]
          wave: [ 0.0, 1.0, 0.0, 0.0 ]
          amplitude: 0.0

numerical_scheme: verlet_nve

global:
  max_iteration: 100
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: 1
  simulation_snapshot_frequency: -1
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
  force_flush_file: true
  log_mode: "stp;tmp;toe;poe;kie;ele;ite"
