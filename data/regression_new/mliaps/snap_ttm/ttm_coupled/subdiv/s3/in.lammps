# exaStamp parity counterpart of LAMMPS examples/snap_ttm/snap_ttm_couplage_ttm (Te-dependent SNAP + fix ttm),
# made deterministic: 4^3 TTM grid = exaStamp 4^3 cell grid (grid_subdiv 1), non uniform initial Te (ttm_grid.in,
# 1.5/2.5/3.5/4.5 eV along x), Langevin coupling off (gamma_p > 0 is required: 1e-50 -> noise ~1e-18 eV/ang,
# gamma_s 0), so Te only evolves by diffusion. NEEDS the fix ttm pre_force patch (src/EXTRA-FIX/fix_ttm.cpp):
# without it f_twotemp is set after the pair style (one step late).
variable nsteps index 100
units           metal
boundary        p p p
lattice         fcc 4.078
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 196.9665

#              seed   C_e       rho_e    kappa_e   gamma_p gamma_s v_0     Nx Ny Nz
fix twotemp all ttm 342785 1.2470e-5 0.087614 0.0005365 1e-50   0.0     58.4613 12 12 12 infile ttm_grid.in

pair_style hybrid/overlay zbl 2.0 3.5 snap_ttm
pair_coeff 1 1 zbl 79 79
pair_coeff * * snap_ttm dir.inputs/Au.snapcoeff dir.inputs/Au.snapparam dir.inputs/Au.snapbetas Au f_twotemp

compute avgte all reduce ave f_twotemp
thermo          1
thermo_style    custom step temp pe ke etotal press c_avgte
thermo_modify   norm yes format float %.16g

timestep 1.0e-3
neighbor 1.0 bin
neigh_modify once no every 1 delay 0 check yes

velocity all create 600.0 3423 dist gaussian
write_dump all custom init.dump id type x y z vx vy vz modify sort id format float %.17g
fix 1 all nve
run             ${nsteps}
