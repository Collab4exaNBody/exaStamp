species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

setup_system:
  - particle_regions:
      - CYL1:
          quadric:
            shape: cylx
            transform:
              - scale: [ 1 ang, 15 ang, 15 ang ]
              - translate: [ 1 ang, 20 ang, 20 ang ]
      - CYL2:
          quadric:
            shape: cylx
            transform:
              - scale: [ 1 ang, 13 ang, 24 ang ]
              - xrot: pi/3.
              - translate: [ 1 ang, 72 ang, 72 ang ]
  - domain:
      cell_size: 5 ang
      grid_dims: [ 5, 20, 20 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 25. ang, 100. ang, 100. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 2.5 ang, 2.5 ang, 2.5 ang ]
      region: not ( CYL1 or CYL2 )
  - lattice:
      structure: FCC
      types: [ Ta, Ta, Ta, Ta ]
      size: [ 5.0 ang, 5.0 ang, 5.0 ang ]
      region: CYL2
  - lattice:
      structure: SC
      types: [ Ta ]
      size: [ 2.5 ang, 2.5 ang, 2.5 ang ]
      region: CYL1
  - gaussian_noise_r:
      sigma: 0.05 ang

global:
  max_iteration: 1
  dt: 1.0e-3 ps
  rcut_max: 4.8 ang

compute_descriptor_snap:
  nneigh_bispectrum: 48
  closest_bispectrum: false
  neigh_margin: 0.1
  parameters:
    param: "param.txt"
    coef: "coeff.txt"

compute_slcsa:
  lda_scalings: [[ 0.02246624,  0.03267447, -0.03402774],
                 [-0.58093538, -0.14740569, -0.20141953],
