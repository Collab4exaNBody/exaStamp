species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

eam_alloy_force:
  rcut: 5.30 ang
  parameters:
    file: "../../potentials/Ta1_Ravelo_2013.eam.alloy"

compute_force: eam_alloy_force

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_v: { sigma: 200. m/s }

global:
  max_iteration: 20
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 20
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps
  rcut_max: &defgrad_rcut 6.0 ang
  deterministic_noise: true 

init_epilog:
  - backup_r_lt

write_snapshot:
  - copy_grid
  - restore_ghost_r0:
      rebind: { grid: grid_copy }
      body:
        - backup_r_lt_move_data
        - restore_r_lt
        - ghost_update_r
  - compute_F:
      rebind: { grid_t0: grid_copy }
      body:
        - compute_deformation_gradient_tensor:
            rcut: *defgrad_rcut
            weight_function: [ 1.0 , 0.0 , 0.0 ]
            defgrad_field: FF
  - compute_green_lagrange_strain:
      defgrad_field: FF
      strain_field: EE
  - compute_polar_decomposition:
      defgrad_field: FF
      rot_field: RR
      stretch_field: UU
  - compute_microrotation:
      rot_field: RR
      microrot_field: mu
  - compute_slip_tripod:
      defgrad_field: FF
      burgerpar_field: bparloc
      burgerortho_field: borloc
      glide_field: nloc
  - compute_jacobian:
      defgrad_field: FF
      jacobian_field: J
  - compute_strain_invariants:
      tensor_field: EE
      i1_field: I1
      i2_field: I2
      i3_field: I3
  - compute_von_mises_strain:
      tensor_field: EE
      vonmises_field: J2
  - compute_shear_strain:
      tensor_field: EE
      shear_strain_field: SS
  - timestep_file: "xyz/current_config_%09d.xyz"
  - write_xyz: { fields: [ id, type, FF, EE, RR, UU, mu, bparloc, borloc, nloc, J, I1, I2, I3, J2, SS ] }

  
