species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

eam_alloy_force:
  rcut: 5.30 ang
  parameters:
    file: "Ta1_Ravelo_2013.eam.alloy"

compute_force: eam_alloy_force

setup_system:
  - particle_regions:
      - CYL:
          quadric:
            shape: cylx
            transform:
              - scale: [ 15 ang, 20 ang, 10 ang ]
              - xrot: pi/4
              - translate: [ 33 ang, 33 ang, 33 ang ]
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_v:
      sigma: 100. m/s
  - shift_v:
      value: [ 0, 800. m/s, 400. m/s ]
      region: CYL

global:
  max_iteration: 20
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 20
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps
  rcut_max: &defgrad_rcut 6.0 ang
  deterministic_noise: true 

write_snapshot:
  - ghost_update_r_v
  - compute_velocity_gradient_tensor:
      rcut: *defgrad_rcut
      weight_function: [ 1.0 , 0.0 , 0.0 ]
      velgrad_field: L
  - compute_vorticity:
      velgrad_field: L
      vort_field: phi
  - timestep_file: "xyz/current_config_%09d.xyz"
  - write_xyz: { fields: [ id, type, L, phi, velocity ] }

  
