species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

eam_alloy_force:
  rcut: 5.30 ang
  parameters:
    file: "../../potentials/Ta1_Ravelo_2013.eam.alloy"

compute_force: eam_alloy_force

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_v: { sigma: 200. m/s }
    
global:
  max_iteration: 20
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps
  rcut_max: &defgrad_rcut 6.0 ang
#  deterministic_noise: true 

init_epilog:
  - backup_r_lt

write_snapshot:
  - copy_grid
  - restore_ghost_r0:
      rebind: { grid: grid_copy }
      body:
        - backup_r_lt_move_data
        - restore_r_lt
        - ghost_update_r
  - compute_F:
      rebind: { grid_t0: grid_copy }
      body:
        - compute_deformation_gradient_tensor:
            rcut: *defgrad_rcut
            weight_function: [ 1.0 , 0.0 , 0.0 ]
            defgrad_field: F
  - compute_jacobian:
      defgrad_field: F
      jacobian_field: J            
  - average_neighbors_scalar:
      nbh_field: mass
      avg_field: avgmass
      rcut: 6.0 ang
  - timestep_file: "xyz/particles_%09d.xyz"
  - write_xyz: { fields: [ id, type, mass, avgmass ] }
  - grid_flavor
  - resize_grid_cell_values
  - atom_cell_projection:
      fields: [ "mv2" , "mass" , "type" , "J", "F" ]
      grid_subdiv: 1
      splat_size: 5.5 ang
  - update_gcv_from_ghost
  - timestep_file: "paraview/grid_%09d"
  - write_grid_vtk
