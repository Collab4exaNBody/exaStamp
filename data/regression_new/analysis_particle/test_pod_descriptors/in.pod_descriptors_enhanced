# LAMMPS mirror of compute_descriptor_pod_enhanced.msp -- same as in.pod_descriptors but
# using the enhanced (use_scaled_lj + fadein_mu/fadein_delta) Ta parameter/coefficient
# files, exercising the exaStamp port-parity fix (see eapod.cpp: use_scaled_lj, fadein_mu,
# fadein_delta).

units       metal
atom_style  atomic
boundary    p p p

read_data   Ta_disturbed.lmp

pair_style  zero 5.01
pair_coeff  * *

compute podd all pod/atom Ta_param_enhanced.pod Ta_coefficients_enhanced.pod Ta

dump        1 all custom 1 lammps_pod_descriptors_enhanced.txt id x y z c_podd[*]
dump_modify 1 sort id
dump_modify 1 format float "%.17g"

run         0
