species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

init_parameters:
  - species
  - pod_init:
      parameters:
        pod_file: "Ta_param.pod"
        coeff_file: "Ta_coefficients.pod"

setup_system:
  - domain:
      cell_size: 8.0 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "Ta_small.xyz"

global:
  max_iteration: 1
  dt: 1.0e-3 ps

simulation_epilog:
  - compute_descriptor_pod: { compute_derivative: true }
  - update_opt_from_ghost: { opt_fields: [ "pda_.*" ] }
  - write_descriptor_pod:
      filename: "exastamp_pod_derivative_small.txt"
      fields: [ id, x, y, z, derivative ]
