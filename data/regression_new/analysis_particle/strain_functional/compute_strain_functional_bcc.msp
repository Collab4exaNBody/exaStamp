# Strain Functional Descriptors on a noisy BCC tantalum crystal.
# rcut = 5.6 sigma: neighbor weights below 1.6e-7 are neglected.
species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

compute_force: nop

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 33. ang, 33. ang, 33. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_r:
      sigma: 0.05 ang

global:
  deterministic_noise: true
  max_iteration: 0
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_max: 6.0 ang
  rcut_inc: 0.5 ang
  dt: 1.0e-3 ps

compute_strain_functional:
  rcut: 5.093590329 ang
  sigma: 0.909569702 ang
  spherical_tensors: true

strain_functional_fields:
  fields: [ w, P1_I0, P2_I0, P2_I1, P2_I2, P3_I0, P3_I4, P4_I0, P4_I6, P4_I8, O2_I0, P22_0, P44a_4r ]

simulation_epilog:
  - compute_strain_functional
  - strain_functional_fields
  - timestep_file: "sfd_bcc.xyz"
  - write_xyz: { fields: [ id, sfd_w, sfd_P1_I0, sfd_P2_I0, sfd_P2_I1, sfd_P2_I2, sfd_P3_I0, sfd_P3_I4, sfd_P4_I0, sfd_P4_I6, sfd_P4_I8, sfd_O2_I0, sfd_P22_0, sfd_P44a_4r ] }
