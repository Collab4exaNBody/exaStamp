# LAMMPS mirror of compute_descriptor_snap.msp: same tantalum_noisy configuration, same
# fixed-cutoff mono-element SNAP bispectrum descriptor (rcutfac=6.0, rfac0=0.99363,
# twojmax=6, radelem=0.5, weight=1, rmin0=0, bzeroflag=0, quadraticflag=0, switchflag=1
# default -- see ../param.txt / ../coeff.txt). Dumps one line per atom, id-sorted:
#   id x y z d0 d1 ... d29
# to lammps_descriptors.txt, directly comparable to exastamp_descriptors.txt.

units       metal
atom_style  atomic
boundary    p p p

read_data   tantalum_noisy.data

# compute sna/atom needs a pair style defined (to build the neighbor list) but no real
# potential is needed here -- pair_style zero just sets the cutoff for neighbor-list
# construction. Cutoff must be >= rcutfac*(R_i+R_j) = 6.0*(0.5+0.5) = 6.0.
pair_style  zero 6.01
pair_coeff  * *

compute snapdesc all sna/atom  6.0 0.99363 6 0.5 1.0 rmin0 0.0 bzeroflag 0 quadraticflag 0
# snad/atom's per-atom row is the LAMMPS aggregation of the bispectrum derivative:
# row[i] = dBi/dRi (self term) + sum over atoms k that have i as a neighbor of -dBk/dRi.
# Column layout for ntypes=1: [dBx for k=0..ncoeff-1][dBy for k=0..ncoeff-1][dBz for k=0..ncoeff-1].
compute snaddesc all snad/atom 6.0 0.99363 6 0.5 1.0 rmin0 0.0 bzeroflag 0 quadraticflag 0

dump        1 all custom 1 lammps_descriptors.txt id x y z c_snapdesc[*]
dump_modify 1 sort id
dump_modify 1 format float "%.17g"

dump        2 all custom 1 lammps_snad.txt id x y z c_snaddesc[*]
dump_modify 2 sort id
dump_modify 2 format float "%.17g"

run         0
