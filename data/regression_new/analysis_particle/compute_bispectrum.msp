species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 4, 4, 4 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 26.4 ang, 26.4 ang, 26.4 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]

global:
  max_iteration: 1
  dt: 1.0e-3 ps
  rcut_max: 4.8 ang

compute_bispectrum:
  nneigh_bispectrum: 32
  closest_bispectrum: false
  neigh_margin: 0.2
  parameters:
    param: "param.txt"
    coef: "coeff.txt"

simulation_epilog:
  - compute_bispectrum
  - print_test:
      rebind: { value: ncoeff }
      body:
        - print_int: { prefix: "ncoeff=", suffix: "\n" }
