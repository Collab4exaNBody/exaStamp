species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

init_parameters:
  - species
  - snap_init:
      parameters:
        param: "param.txt"
        coef: "coeff.txt"

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 4, 4, 4 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 26.4 ang, 26.4 ang, 26.4 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]

global:
  max_iteration: 1
  dt: 1.0e-3 ps
  # rcut_max no longer needed here -- snap_init sets it early (init_parameters, before setup_system)

compute_descriptor_snap:
  nneigh_bispectrum: 32
  closest_bispectrum: false
  neigh_margin: 0.2

simulation_epilog:
  - compute_descriptor_snap
  - print_test:
      rebind: { value: ncoeff }
      body:
        - print_int: { prefix: "ncoeff=", suffix: "\n" }
