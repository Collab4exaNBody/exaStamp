# EAM alloy, multipass scheme with half neighbor lists (each pair computed once, contributions to both atoms):
# ghost contributions to densities, forces and energies are folded back to their owners
includes:
  - baseline_single_species.yaml
  - config_update_symmetric_forces.msp   # forces/energies of ghost partners folded back to their owners

eam_rho:
  - eam_alloy_force: { rcut: 5.30 ang , eam_rho: true , eam_rho2emb: false , eam_ghost: false , eam_force: false , eam_symmetry: true }

eam_force:
  - eam_alloy_force: { rcut: 5.30 ang , eam_rho: false , eam_rho2emb: false , eam_ghost: false , eam_force: true , eam_symmetry: true }

compute_force:
  rebind: { parameters: eam_alloy_parameters }
  body:
    - eam_rho
    - update_opt_from_ghost: { opt_fields: [ "rho_dEmb" ] }   # densities of ghost partners folded back to their owners
    - eam_rho2emb
    - ghost_update_opt: { opt_fields: [ "rho_dEmb" ] }        # embedding derivatives of owners sent to the ghosts
    - eam_force
