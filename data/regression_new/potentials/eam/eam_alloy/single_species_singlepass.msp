# EAM alloy, single pass: densities are also computed for the ghosts (extra ghost layer), so no intermediate
# ghost communication is needed. Simplest, but computes more.
includes:
  - baseline_single_species.yaml

compute_force:
  rebind: { parameters: eam_alloy_parameters }
  body:
    - eam_alloy_force: { rcut: 5.30 ang , eam_rho: true , eam_rho2emb: true , eam_ghost: true , eam_force: true , eam_symmetry: false }
