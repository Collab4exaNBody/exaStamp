# Coulomb-only exaStamp counterpart of in.coul (case ewald_fixed, variant fold): compared with LAMMPS dumps of the same case
configuration:
  nogpu: true
  logging: { debug: false }

grid_flavor: grid_flavor_full

species:
  - O: { mass: 15.999000 Da , z: 8 , charge: -1.1104 e- }
  - U: { mass: 238.02891 Da , z: 92 , charge: 2.2208 e- }

init_parameters:
  - coulombic_ewald_init

coulombic_ewald_init:
  accuracy_relative: 1.0e-5
  g_ewald: 0.3 1/ang
  radius: 10.0 ang
  kmax: 8

coulombic_ewald_short_range:
  use_symmetry: true
  ghost_fold_back: true

compute_force:
  - coulombic_ewald_short_range
  - coulombic_ewald_long_range

setup_system:
  - domain:
      cell_size: 5.5 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "UO2_disturbed_ext.xyz"
      pbc_adjust_xform: true
  - copy_charge_specy_to_particle
  - sum_charges
  - coulombic_ewald_init

write_snapshot:
  - timestep_file: "exastamp_ewald_fixed+fold_%09d.xyz"
  - write_xyz:
      fields: [ "id", "type", "force", "ep" ]
      units: { force: "eV/ang", ep: "eV" }

+first_iteration:
  - write_snapshot

global:
  max_iteration: 10
  simulation_thermostate_screen_frequency: 1
  simulation_thermostate_file_frequency: 1
  thermostate_file: "thermo_exastamp_ewald_fixed+fold.csv"
  simulation_snapshot_frequency: 10
  rcut_inc: 1.0 ang
  dt: 0.001 ps

# ghost_fold_back : pairs are computed from owned cells only, contributions to ghost particles are added back to
# their owners. Ghost forces, energies and virials must be zeroed before, and folded back after the force computation.
compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force_epilog:
  - update_virial_force_energy_from_ghost
  - force_to_accel

# half neighbor lists (optional with use_symmetry, halves the neighbor list memory)
chunk_neighbors:
  config:
    free_scratch_memory: false
    build_particle_offset: true
    subcell_compaction: true
    scratch_mem_per_cell: 1048576
    stream_prealloc_factor: 1.05
    chunk_size: 1
    half_symmetric: true
