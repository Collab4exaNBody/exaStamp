LAMMPS (4 Jul 2026)
  using 1 OpenMP thread(s) per MPI task
# Coulomb-only ground truth on disturbed UO2 (12000 atoms), LAMMPS metal units.
# Usage: lmp -in in.coul -var case <wolf|dsf|ewald_auto|ewald_fixed|ewald_tri|ewald_tri_fixed|pppm|pppm_tri>
# *_tri cases use UO2_tri.lmp : same fractional coordinates in a triclinic cell (xy=5 xz=3 yz=4 ang)
units        metal
dimension    3
boundary     p p p
atom_style   charge
atom_modify  map array

variable data string UO2_disturbed_charge.lmp
if "${case} == ewald_tri || ${case} == ewald_tri_fixed || ${case} == pppm_tri" then "variable data string UO2_tri.lmp"
read_data    ${data}
read_data    UO2_disturbed_charge.lmp
Reading data file ...
  triclinic box = (0 0 0) to (54.5 54.5 54.5) with tilt (0 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  12000 atoms
  read_data CPU = 0.038 seconds

group  U type 1
4000 atoms in group U
set group U charge 2.2208
Setting atom values ...
  4000 settings made for charge
group  O type 2
8000 atoms in group O
set group O charge -1.1104
Setting atom values ...
  8000 settings made for charge

if "${case} == wolf" then   "pair_style coul/wolf 0.2 10.0"   "pair_coeff * *"
if "${case} == dsf" then   "pair_style coul/dsf 0.2 10.0"   "pair_coeff * *"
if "${case} == ewald_auto || ${case} == ewald_tri" then   "pair_style coul/long 10.0"   "pair_coeff * *"   "kspace_style ewald 1.0e-5"
if "${case} == ewald_fixed || ${case} == ewald_tri_fixed" then   "pair_style coul/long 10.0"   "pair_coeff * *"   "kspace_style ewald 1.0e-5"   "kspace_modify gewald 0.3 kmax/ewald 8 8 8"

if "${case} == pppm || ${case} == pppm_tri" then   "pair_style coul/long 10.0"   "pair_coeff * *"   "kspace_style pppm 1.0e-5"   "kspace_modify diff ik order 5"
pair_style coul/long 10.0
pair_coeff * *
kspace_style pppm 1.0e-5
kspace_modify diff ik order 5

# no tables: real-space part uses the A&S erfc polynomial, same as coulombic/ewald.h
if "${case} != wolf && ${case} != dsf" then "pair_modify table 0"
pair_modify table 0

compute pe all pe/atom
compute st all stress/atom NULL virial

neighbor     1.0 bin
neigh_modify delay 0 every 1 check yes

thermo_style custom step pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.12e
thermo       1

dump d all custom 10 dump_${case}.*.txt id type x y z fx fy fz c_pe c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
dump d all custom 10 dump_pppm.*.txt id type x y z fx fy fz c_pe c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
dump_modify d sort id format float %.15e

timestep     0.001
fix 1 all nve
run 10
