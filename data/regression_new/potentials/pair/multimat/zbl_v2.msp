includes:
  - baseline.yaml

species:
  - Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }

# zbl_v2: MiLaDy's ZBL (3-exponential screening). Zn-Zn in switched mode (quintic smoothstep r1..r2),
# Cu-Zn in bridge mode (ZBL below r1, exponential bridge up to rr).
compute_force_pair_multimat:
  potentials:
    - { type_a: Zn , type_b: Zn , potential: zbl_v2 , rcut: 5.60 ang , parameters: { mode: switched, r1: 2.5 ang, r2: 5.0 ang } }
    - { type_a: Cu , type_b: Zn , potential: zbl_v2 , rcut: 5.60 ang , parameters: { mode: bridge, r1: 1.0 ang, rr: 5.6 ang, bridge_type: exp, bridge: [ 1.0, -1.2, 0.0, 0.0 ] } }

compute_force: compute_force_pair_multimat

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0, Zn: 1 }
  - particle_type_add_properties:
      Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
      Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - domain:
      cell_size: 5 ang
      grid_dims: [8,8,8]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Zn, Cu, Zn ]
      size: [ 5.0 ang , 5.0 ang , 5.0 ang ]
  - gaussian_noise_r: { sigma: 0.1 ang }
  - gaussian_noise_v: { sigma: 50. m/s }
