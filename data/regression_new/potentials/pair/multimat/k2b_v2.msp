includes:
  - baseline.yaml

species:
  - Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }

# k2b_v2: MiLaDy's 2-body kernel patch (per element-pair weights on Gaussians centred at zr, cutoff
# function of type fcut_type). Pair factor automatic: 4 for Zn-Zn (same z), 2 for Cu-Zn.
compute_force_pair_multimat:
  potentials:
    - { type_a: Zn , type_b: Zn , potential: k2b_v2 , rcut: 5.5 ang , parameters: { sigma: 0.4 ang, delta: 0.5, fcut_type: 3, r_cut: 5.5 ang, r_cut_width: 0.5 ang,
        zr: [ 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5 ],
        w: [ 2.0, 1.0, 0.4, 0.1, -0.05, -0.08, -0.04, -0.01, 0.0, 0.0 ] } }
    - { type_a: Cu , type_b: Zn , potential: k2b_v2 , rcut: 5.5 ang , parameters: { sigma: 0.4 ang, delta: 0.5, fcut_type: 3, r_cut: 5.5 ang, r_cut_width: 0.5 ang,
        zr: [ 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5 ],
        w: [ 1.5, 0.8, 0.3, 0.05, -0.06, -0.07, -0.03, -0.01, 0.0, 0.0 ] } }

compute_force: compute_force_pair_multimat

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0, Zn: 1 }
  - particle_type_add_properties:
      Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
      Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - domain:
      cell_size: 5 ang
      grid_dims: [8,8,8]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Zn, Cu, Zn ]
      size: [ 5.0 ang , 5.0 ang , 5.0 ang ]
  - gaussian_noise_r: { sigma: 0.1 ang }
  - gaussian_noise_v: { sigma: 50. m/s }
