# Stillinger-Weber Si, exaStamp counterpart of in.lammps.
# init.xyz = step-0 state (lattice + velocity create) from init.dump via ../../../mliaps/snap/lmp2xyz.py
includes:
  - config_update_symmetric_forces.msp

configuration:
  profiling:
    summary: false

species:
  - Si: { mass: 28.0855 Da , z: 14 , charge: 0.0 e- }

init_parameters:
  - species
  - sw_init:
      parameters: { file: "Si.sw" }

compute_force:
  - sw_force

grid_flavor: grid_flavor_full

setup_system:
  - domain:
      cell_size: 5.431 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "init.xyz"
      bounds_mode: FILE
      read_velocities: true

numerical_scheme: verlet_nve

global:
  max_iteration: 100
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: 1
  log_mode: "stp;pht;prt;toe;kie;poe;tmp;pre;pxx;pyy;pzz;pxy;pxz;pyz"
  simulation_snapshot_frequency: -1
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
  force_flush_file: true
