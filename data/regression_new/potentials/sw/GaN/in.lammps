# Stillinger-Weber GaN zincblende (Ga = type 1, N = type 2), ground truth for GaN_exaStamp.msp
variable nsteps index 100
units           metal
boundary        p p p

lattice         diamond 4.50
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box basis 5 2 basis 6 2 basis 7 2 basis 8 2
mass 1 69.723
mass 2 14.007

pair_style      sw
pair_coeff      * * GaN.sw Ga N

thermo          1
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   norm yes format float %.16g

timestep 1.0e-3
neighbor 1.0 bin
neigh_modify once no every 1 delay 0 check yes

velocity all create 1000.0 4928459 loop geom
write_dump all custom init.dump id type x y z vx vy vz modify sort id format float %.17g
fix 1 all nve
run             ${nsteps}
