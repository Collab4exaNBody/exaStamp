# enable-if-EXASTAMP_AIO_WITH_ZLIB
includes:
  - baseline.yaml

# Compressed input (.gz, .bz2, .xz): detected from the file content, read without a temporary file.
setup_system:
  # the readers keep the deck's domain (cell size, periodicity) and fit it to the file's box
  - domain:
      cell_size: 6.6 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_lammps_data:
      file: Ta_bcc.lmp.gz
