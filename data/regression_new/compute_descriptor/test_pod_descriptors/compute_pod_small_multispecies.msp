species:
  - A: { mass: 1.0 Da, z: 1, charge: 0 e- }
  - B: { mass: 1.0 Da, z: 1, charge: 0 e- }

init_parameters:
  - species
  - pod_init:
      parameters:
        pod_file: "AB_param.pod"
        coeff_file: "AB_coefficients.pod"

setup_system:
  - domain:
      cell_size: 8.0 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "AB_small.xyz"

global:
  max_iteration: 1
  dt: 1.0e-3 ps

simulation_epilog:
  - compute_descriptor_pod: { compute_derivative: true }
  - compute_descriptor_pod_global
  - write_descriptor_pod_global: { filename: "exastamp_pod_small_multispecies.txt" }
