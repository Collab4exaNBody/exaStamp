# Small (8-atom) W/Be LAMMPS ground truth for cross-validating exaStamp's compute_descriptor_snap_global
# multi-type (ntypes>1) support against real LAMMPS compute snap. Rows/cols (31 x 111) are specific
# to this fixed 8-atom WBe_small system + WBe_Wood_PRB2019 param/coeff (ncoeff=55 per type -- SNA's
# own bispectrum-component count for twojmax=8, NOT the coeff file's "56" header value, which
# includes an extra per-element linear-regression intercept term compute snap doesn't output --
# ntypes=2 -> 110 cols + 1 trailing reference-label column = 111; 1+3*8+6=31 rows).

units       metal
atom_style  atomic
boundary    p p p

read_data   WBe_small.lmp

pair_style  zero 5.01
pair_coeff  * *

variable    rcutfac  equal 4.8123
variable    rfac0    equal 0.99363
variable    twojmax  equal 8
variable    radelem1 equal 0.5
variable    radelem2 equal 0.417932
variable    wj1      equal 1.0
variable    wj2      equal 0.959049

compute snapg all snap ${rcutfac} ${rfac0} ${twojmax} ${radelem1} ${radelem2} ${wj1} ${wj2} rmin0 0.0 bzeroflag 1 quadraticflag 0

run         0

