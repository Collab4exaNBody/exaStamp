# Small (8-atom) In/P LAMMPS ground truth for cross-validating exaStamp's compute_descriptor_snap_global
# chem_flag=true (multi-element bispectrum) support against real LAMMPS compute snap. Rows/cols
# (31 x 481) are specific to this fixed 8-atom InP_small system + InP_JCPA2020 param/coeff
# (ncoeff=240 per type -- SNA's own chem_flag=true bispectrum-component count for twojmax=6,
# nelements=2, NOT the coeff file's "241" header value, which includes an extra per-element
# linear-regression intercept term compute snap doesn't output -- ntypes=2 -> 480 cols + 1
# trailing reference-label column = 481; 1+3*8+6=31 rows).

units       metal
atom_style  atomic
boundary    p p p

read_data   InP_small.lmp

pair_style  zero 8.5
pair_coeff  * *

variable    rcutfac  equal 1.0
variable    rfac0    equal 0.99363
variable    twojmax  equal 6
variable    radelem1 equal 3.81205
variable    radelem2 equal 3.82945
variable    wj1      equal 1.0
variable    wj2      equal 0.929316

compute snapg all snap ${rcutfac} ${rfac0} ${twojmax} ${radelem1} ${radelem2} ${wj1} ${wj2} rmin0 0.0 bzeroflag 1 quadraticflag 0 chem 2 0 1 bnormflag 1 wselfallflag 1

run         0

