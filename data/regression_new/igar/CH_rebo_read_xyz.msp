species:
  - C: { z: 12, mass: 12.0107 Da, charge: 0.0 e- }

init_parameters:
  - species
  - rebo_init:
      parameters:
        potential_file: "CH.rebo"

compute_force_prolog:
  - zero_force_energy: { ghost: true }

langevin_thermostat:
  Tstart: 5000. K
  Tstop: 4000. K
  gamma: 0.1 ps^-1

numerical_scheme: verlet_lnvt

rebo_compute_force:
  - rebo_bond_order
  - ghost_update_opt: { opt_fields: [ "NijC", "NijH" ] }
  - rebo_conjugation
  - ghost_update_opt: { opt_fields: [ "Nconj" ] }
  - rebo_pairwise
  - rebo_manybody

compute_force:
  - rebo_compute_force
  - igar_force_interp: { energy_factor: 50000.0 }

# rcut_max is computed before the IGAR field is read: igar_force_interp cannot run there
preinit_rcut_max:
  profiling: false
  rebind: { grid: null_grid, chunk_neighbors: null_neighbors, domain: empty_domain }
  body:
    - domain:
        cell_size: 0.0 ang
        grid_dims: [ 0 , 0 , 0 ]
        periodic: [ true , true , true ]
    - rebo_compute_force
    - nbh_dist

# Update forces of non-ghost particles from their ghosts
# before pushing total force to acceleration
compute_force_epilog:
  - update_force_from_ghost
  - force_to_accel

setup_system:
  - domain:
      cell_size: 15.5 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "liquid_carbon.xyz"
      bounds_mode: FILE
  - init_temperature_new:
      T: 5000. K
  - igar_read_field:
      file_name: "igar_test.vtk"   # 128^3 8-bit field (BINARY) written by generate_vtk_grid.py
      storage: uint8
      value_scale: 0.00392156862745098   # 1/255: levels 0-255 -> field in [0,1]

write_snapshot:
  - timestep_file: "Paraview/test_%09d"
  - write_paraview:
      fields: [ id, type, ep, processor_id ]
  - timestep_file: "VTK/test_%09d"

global:
  max_iteration: 10
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 50
  rcut_inc: 1.0 ang
  dt: 0.5 fs
  thermostate_file: "thermo_exastamp_rebo.txt"
