# no-mpi : LCHBOP C-H, hydrocarbon configuration CH216 replicated 2x2x2 (parameter files vCC.par, vHH.par, vCH.par)
# disabled (no-mpi) : with 4 ranks (single-cell-wide subdomains) forces differ from seq by up to 7e-9 relative, energy 2.5e-10 (deterministic, 2 ranks exact) -> many-body reach vs ghost layer, to investigate
# TMPDAT/ must exist : LCHBOP writes debug files there without checking fopen
includes:
  - ../common.yaml

grid_flavor: grid_flavor_full

species:
  - C: { z: 12, mass: 12.0107 Da, charge: 0.0 e- }
  - H: { z: 1, mass: 1.00794 Da, charge: -0.4680 e- }

LCHBOP_inits:
  flag_vmr: true

# LCHBOP builds its own neighbour data (LCHBOP_InitEF) after particles moved across cells
update_particle_neighbors: nop
+parallel_update_particles:
  - cell_owner_rank
  - LCHBOP_InitEF

compute_force:
  - LCHBOP_EF
  - update_virial_force_energy_from_ghost   # LCHBOP also writes virial contributions to ghost atoms

preinit_rcut_max:
  profiling: false
  rebind: { grid: null_grid, chunk_neighbors: null_neighbors, domain: empty_domain }
  body:
    - domain:
        cell_size: 0.0 ang
        grid_dims: [ 0 , 0 , 0 ]
    - nbh_dist: { verbose: false }

init_rcut_max:
  - nbh_dist: { verbose: false }

setup_system:
  - domain:
      cell_size: 10.4660790 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: CH216.xyz
      pbc_adjust_xform: true
  - replicate_domain: [ 2, 2, 2 ]   # the CH216 box is a single cell : replicated so that it can be split over MPI ranks
  - LCHBOP_inits
  - physics_regression_noise

+global:
  dt: 1.0e-4 ps
  pr_acc_threshold: 1.e-6   # H accelerations up to ~1e5 (internal units): 5e-8 absolute = 5e-13 relative between seq and par
  pr_vel_threshold: 1.e-9   # velocities up to ~140 ang/ps
  rcut_max: 8.4 ang
  rcut_inc: 1.0 ang
  ghost_dist: 8.4 ang
