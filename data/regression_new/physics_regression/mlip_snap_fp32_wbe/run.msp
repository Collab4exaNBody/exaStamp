# enable-if-EXASTAMP_MLIP_SNAP_BUILD : SNAP W-Be + ZBL, two species, snap_force_fp32 (single precision)
includes:
  - ../common.yaml
  - config_update_symmetric_forces.msp

grid_flavor: grid_flavor_full

species:
  - W: { mass: 183.84 Da , z: 74 , charge: 0.0 e- }
  - Be: { mass: 9.012182 Da , z: 4 , charge: 0.0 e- }

zbl_multi_force:
  rcut: 4.8 ang
  parameters:
    - { type_a: W , type_b: W , rcut: 4.8 ang , parameters: { r1: 4.0 ang , rc: 4.8 ang } }
    - { type_a: W , type_b: Be , rcut: 4.8 ang , parameters: { r1: 4.0 ang , rc: 4.8 ang } }
    - { type_a: Be , type_b: Be , rcut: 4.8 ang , parameters: { r1: 4.0 ang , rc: 4.8 ang } }

compute_force:
  - zbl_multi_force
  - snap_force_fp32:
      parameters:
        nt: 2
        param: "WBe_Wood_PRB2019.snapparam"
        coef:  "WBe_Wood_PRB2019.snapcoeff"

setup_system:
  - domain:
      cell_size: 6.3606 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 31.8030 ang, 31.8030 ang, 31.8030 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ W, Be ]
      size: [ 3.1803 ang, 3.1803 ang, 3.1803 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 0.5e-3 ps
  # single precision (references made on GPU, 1 rank 1 thread). Measured spread vs references (L2):
  # GPU 4 ranks: pos 2.7e-8, vel 1.0e-5, acc 9e-3, energy/virial 9e-9 ; CPU (AVX2) seq/mt/par: pos 9.5e-8,
  # vel 3.4e-5, acc 2.6e-2, energy/virial 7.8e-8. Double precision differs from these references by 3.9e-7 on
  # the energies: pr_thermo_threshold still tells the two precisions apart
  pr_pos_threshold: 1.e-6
  pr_vel_threshold: 5.e-4
  pr_acc_threshold: 0.3
  pr_thermo_threshold: 2.e-7
