# ljwolf, two species, multi_force
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - C: { mass: 12.011 Da , z: 6 , charge: 0.4 e- }
  - N: { mass: 14.007 Da , z: 7 , charge: -0.4 e- }

ljwolf_multi_force:
  rcut: 12.5 ang
  common_parameters: { coul_wolf: { alpha: 0.2 1/ang, rc: 12.5 ang }, lj_rcut: 11.0 ang, shiftlj: true, lj: { epsilon: 0.01 kcal/mol, sigma: 3.830864488 ang } }
  parameters:
    - { type_a: C  , type_b: C, rcut: 12.5 ang, parameters: { coul_wolf: { alpha: 0.2 1/ang, rc: 12.5 ang }, lj_rcut: 11.0 ang, shiftlj: true, lj: { epsilon: 0.01 kcal/mol, sigma: 3.830864488 ang } } }
    - { type_a: C  , type_b: N, rcut: 12.5 ang, parameters: { coul_wolf: { alpha: 0.3 1/ang, rc: 12.5 ang }, lj_rcut: 11.0 ang, shiftlj: true, lj: { epsilon: 0.01 kcal/mol, sigma: 3.830864488 ang } } }

compute_force: ljwolf_multi_force

setup_system:
  - particle_types:
      particle_type_map: { C: 0, N: 1 }
  - particle_type_add_properties:
      C: { mass: 12.011 Da , z: 6 , charge: 0.4 e- }
      N: { mass: 14.007 Da , z: 7 , charge: -0.4 e- }
  - domain:
      cell_size: 5 ang
      grid_dims: [8,8,8]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ C, N, C, N ]
      size: [ 5.0 ang , 5.0 ang , 5.0 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
