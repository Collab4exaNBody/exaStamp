# lj, single species, symmetric computation
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Ar: { mass: 39.948 Da , z: 18 , charge: 0.0 e- }

lj_compute_force_symetric:
  parameters: { epsilon: 0.0104 eV , sigma: 3.4 ang }
  rcut: 8.0 ang

compute_force: lj_compute_force_symetric

setup_system:
  - particle_types:
      particle_type_map: { Ar: 0 }
  - particle_type_add_properties:
      Ar: { mass: 39.948 Da , z: 18 , charge: 0.0 e- }
  - domain:
      cell_size: 5 ang
      grid_dims: [8,8,8]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Ar, Ar, Ar, Ar ]
      size: [ 5.0 ang , 5.0 ang , 5.0 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
