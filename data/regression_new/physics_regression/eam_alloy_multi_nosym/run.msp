# eam/alloy, two species, nosym kernel
# generated from potentials/eam inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Al: { mass: 26.982 Da , z: 13 , charge: 0 e- }
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0 e- }

configuration:
  physics:
    units:
      length: angstrom
      mass: Dalton
      time: picosecond
      charge: elementary_charge
      temperature: kelvin
      amount: particle
      luminosity: candela
      angle: radian
      energy: joule
  logging:
    debug: false

ghost_config: &ghost_update_params
  gpu_buffer_pack: true
  async_buffer_pack: true
  staging_buffer: true
  serialize_pack_send: true
  wait_all: false

ghost_config_opt: &ghost_update_opt_params
  gpu_buffer_pack: true
  async_buffer_pack: true
  staging_buffer: true
  serialize_pack_send: true
  wait_all: true
  opt_fields: [ "rho_dEmb" ]

update_force_energy_from_ghost: *ghost_update_params

ghost_update_r: *ghost_update_params

ghost_update_all_no_fv: *ghost_update_params

ghost_update_opt: *ghost_update_opt_params

init_parameters:
  rebind: { parameters: eam_alloy_parameters }
  body:
    - eam_alloy_init:
        parameters:
          file: "AlCu.eam.alloy"

chunk_neighbors:
  config:
    chunk_size: 4
    build_particle_offset: true

eam_rho:
  - eam_alloy_force: { rcut: 6.6825 ang , eam_rho: true , eam_rho2emb: false , eam_ghost: false , eam_force: false , eam_symmetry: false }

eam_rho2emb:
  - eam_alloy_force: { rcut: 6.6825 ang , eam_rho: false , eam_rho2emb: true , eam_ghost: false , eam_force: false , eam_symmetry: false }

eam_force:
  - eam_alloy_force: { rcut: 6.6825 ang , eam_rho: false , eam_rho2emb: false, eam_ghost: false , eam_force: true , eam_symmetry: false }

compute_force:
  rebind: { parameters: eam_alloy_parameters }
  body:
    - eam_rho
    - eam_rho2emb
    - ghost_update_opt
    - eam_force

setup_system:
  - particle_types:
      particle_type_map: { Al: 0, Cu: 1}
  - particle_type_add_properties:
      Al: { mass: 26.982 Da , z: 13 , charge: 0 e- }
      Cu: { mass: 63.546 Da , z: 29 , charge: 0 e- }
  - domain:
      cell_size: 7.2 ang
      grid_dims: [10,10,10]
      bounds: [[0 ang ,0 ang,0 ang],[72 ang, 72 ang, 72 ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Al, Cu]
      size: [ 3.6 ang , 3.6 ang , 3.6 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
