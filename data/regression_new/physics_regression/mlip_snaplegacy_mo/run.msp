# SNAP Mo (Chen 2017), snaplegacy_force
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Mo: { mass: 95.95 Da , z: 42 , charge: 0.0 e- }

snaplegacy_force:
  parameters:
    nt: 2   # Clebsch-Gordan table parameter of snaplegacy (default 2), not a species count
    param: "Mo_Chen_PRM2017.snapparam"
    coef: "Mo_Chen_PRM2017.snapcoeff"

compute_force: snaplegacy_force

setup_system:
  - domain:
      cell_size: 6.32 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 31.6000 ang, 31.6000 ang, 31.6000 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Mo, Mo ]
      size: [ 3.16 ang, 3.16 ang, 3.16 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 0.5e-3 ps
