# Flexible molecules: tetrahydrofuran gas (bonds, bends, torsions, impropers, intramolecular pairs + non-bonding forces)
includes:
  - ../common.yaml
  - config_molecule.msp

compute_bonding_forces:
  - compute_force_bond:
      compute_virial: true
  - compute_force_bend:
      compute_virial: true
  - compute_force_torsion:
      compute_virial: true
  - compute_force_improper:
      compute_virial: true
  - intramolecular_pair_force:
      compute_virial: true

setup_system:
  - domain:
      cell_size: 10. ang
      periodic: [ false, false, false ]
      expandable: false
  - read_fatomes_mol:
      filename: "FAtomes_thf_gas"
      stampinput: "DONNEES_thf_gas"
  - physics_regression_noise

+global:
  dt: 0.5e-15 s
  rcut_inc: 2.0 ang
