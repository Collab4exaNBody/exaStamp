# enable-if-EXASTAMP_MLIP_POLYMLP_BUILD : as mlip_polymlp_tial with the GPU code paths emulated on the host (blocks of 16 threads, several chunks)
includes:
  - ../common.yaml

compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force_epilog:
  - update_force_energy_from_ghost
  - force_to_accel

species:
  - Ti: { mass: 47.867 Da, z: 22, charge: 0 e- }
  - Al: { mass: 26.9815 Da, z: 13, charge: 0 e- }

init_parameters:
  - species
  - polymlp_init:
      parameters: { file: "tial.polymlp.yaml", emulate: 16, mem_gb: 0.0001 }

compute_force:
  - polymlp_force

setup_system:
  - domain:
      cell_size: 4.0 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "tial256.xyz"
  - physics_regression_noise

+global:
  rcut_inc: 0.5 ang
  dt: 1.0e-3 ps
