# MEAM Sn (FCC reference structure, Z=12, r0=3.44 ang), parameters of potentials/meam
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Sn: { mass: 197.1508269E-27 kg , z: 50 , charge: 0 e- }

meam_force:
  rcut: 3.69 ang
  parameters:
    rmax: 3.69 ang
    rmin: 0.0
    Ecoh: 4.93474273599999995322e-19 J
    E0: 4.93474273599999995322e-19 J
    A: 1.000E+00
    r0: 3.44 ang
    alpha: 6.200E+00
    delta: 0.000E+00
    beta0: 6.200E+00
    beta1: 6.000E+00
    beta2: 6.000E+00
    beta3: 6.000E+00
    t0: 1.000E+00
    t1: 4.500E+00
    t2: 6.500E+00
    t3: -0.183E+00
    s0: 1.440E+02
    s1: 0.000E+00
    s2: 0.000E+00
    s3: 0.000E+00
    Cmin: 0.800E+00
    Cmax: 2.800E+00
    Z: 1.200E+01 
    rc: 4.0 ang
    rp: 0.1 ang
# atoms descriptions

compute_force: meam_force

setup_system:
  - domain:
      cell_size: 4.865 ang
      grid_dims: [ 6, 6, 6 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 29.19 ang, 29.19 ang, 29.19 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Sn, Sn, Sn, Sn ]
      size: [ 4.865 ang, 4.865 ang, 4.865 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
