# SNAP Ta06A + ZBL, snap_force_fp64
includes:
  - ../common.yaml
  - config_update_symmetric_forces.msp

grid_flavor: grid_flavor_full

species:
  - Ta: { mass: 180.88 Da , z: 73 , charge: 0.0 e- }

zbl_multi_force:
  rcut: 4.8 ang
  parameters:
    - { type_a: Ta , type_b: Ta , rcut: 4.8 ang , parameters: { r1: 4.0 ang , rc: 4.8 ang } }

compute_force:
  - zbl_multi_force
  - snap_force_fp64:
      parameters:
        nt: 1
        param: "Ta06A.snapparam"
        coef:  "Ta06A.snapcoeff"

setup_system:
  - domain:
      cell_size: 6.632 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 33.1600 ang, 33.1600 ang, 33.1600 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.316 ang, 3.316 ang, 3.316 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 0.5e-3 ps
