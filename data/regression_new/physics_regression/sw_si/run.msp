# Stillinger-Weber Si (sw_init + sw_force), diamond lattice
includes:
  - ../common.yaml

compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force_epilog:
  - update_force_energy_from_ghost
  - force_to_accel

species:
  - Si: { mass: 28.0855 Da, z: 14, charge: 0 e- }

init_parameters:
  - species
  - sw_init:
      parameters: { file: "Si.sw" }

compute_force:
  - sw_force

setup_system:
  - domain:
      cell_size: 5.431 ang
      grid_dims: [ 4, 4, 4 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 21.724 ang, 21.724 ang, 21.724 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice: # diamond / zincblende, 4x4x4 unit cells
      structure: CUSTOM
      types: [ Si, Si, Si, Si, Si, Si, Si, Si ]
      positions:
        [
          [ 0.0, 0.0, 0.0 ], [ 0.0, 0.5, 0.5 ], [ 0.5, 0.0, 0.5 ], [ 0.5, 0.5, 0.0 ],
          [ 0.25, 0.25, 0.25 ], [ 0.25, 0.75, 0.75 ], [ 0.75, 0.25, 0.75 ], [ 0.75, 0.75, 0.25 ],
        ]
      size: [ 5.431 ang, 5.431 ang, 5.431 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
