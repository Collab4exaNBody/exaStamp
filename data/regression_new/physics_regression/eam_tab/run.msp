# tabulated EAM
# generated from potentials/eam inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }

tabeam_force:
  rcut: 7.29 ang
  parameters: tab_sc.yaml

compute_force: tabeam_force

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0 }
  - particle_type_add_properties:
      Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - domain:
      cell_size: 6 ang
      grid_dims: [6,6,6]
      bounds: [[0 ang ,0 ang,0 ang],[36. ang, 36. ang, 36. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Cu, Cu, Cu]
      size: [ 3.6 ang , 3.6 ang , 3.6 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
