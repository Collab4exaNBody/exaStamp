# MEAM (Sn) + Lennard-Jones (O2, N2 pseudo-atoms and gas/Sn), meam_lj_force, parameters of potentials/meam_lj
includes:
  - ../common.yaml
  - config_update_symmetric_forces.msp

grid_flavor: grid_flavor_multimat

species:
  - Sn: { mass: 197.1508269E-27 kg , z: 50 , charge: 0 e- }
  - N2: { mass: 46.517509309e-27 kg , z: 14 , charge: 0 e- }
  - O2: { mass: 53.135293325e-27 kg , z: 16 , charge: 0 e- }

meam_lj_force:
  ghost: false
  meam_type: Sn
  rcut: 4.17 ang
  parameters:
    rmax: 4.17 ang
    rmin: 0.0
    Ecoh: 4.93474273599999995322e-19 J
    E0: 4.93474273599999995322e-19 J
    A: 1.000E+00
    r0: 3.44 ang
    alpha: 6.200E+00
    delta: 0.000E+00
    beta0: 6.200E+00
    beta1: 6.000E+00
    beta2: 6.000E+00
    beta3: 6.000E+00
    t0: 1.000E+00
    t1: 4.500E+00
    t2: 6.500E+00
    t3: -0.183E+00
    s0: 1.440E+02
    s1: 0.000E+00
    s2: 0.000E+00
    s3: 0.000E+00
    Cmin: 0.800E+00
    Cmax: 2.800E+00
    Z: 1.200E+01
    rc: 4.0 ang
    rp: 0.1 ang
  lj_parameters:
    - { type_a: O2  , type_b: O2 , rcut: 8 ang , epsilon: 162.2273150e-23 J , sigma: 3.58 ang }
    - { type_a: N2  , type_b: N2 , rcut: 8 ang , epsilon: 131.3005758e-23 J , sigma: 3.70 ang }
    - { type_a: O2  , type_b: N2 , rcut: 8 ang , epsilon: 145.9470447e-23 J , sigma: 3.64 ang }
    - { type_a: O2  , type_b: Sn , rcut: 8 ang , epsilon: 150.0000000e-24 J , sigma: 3.00 ang }
    - { type_a: N2  , type_b: Sn , rcut: 8 ang , epsilon: 150.0000000e-24 J , sigma: 3.00 ang }

compute_force:
  - meam_lj_force

setup_system:
  - domain:
      cell_size: 4.865 ang
      grid_dims: [ 6, 6, 6 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 29.19 ang, 29.19 ang, 29.19 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:          # gases on FCC sites of the Sn crystal : Sn-Sn MEAM, gas-gas and gas-Sn LJ all exercised
      structure: FCC
      types: [ Sn, Sn, O2, N2 ]
      size: [ 4.865 ang, 4.865 ang, 4.865 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
