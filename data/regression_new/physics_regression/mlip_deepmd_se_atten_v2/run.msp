# DeePMD se_atten_v2 (deepmd_init + deepmd_force, se_atten descriptor), random-weight model (exaStamp/scripts/python/deepmd_test_models.py se_atten_v2), 192-atom water frame from exaStamp/scripts/python/water_frame.py 4 7 (no deepmd-kit data)
includes:
  - ../common.yaml

compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force_epilog:
  - update_force_energy_from_ghost
  - force_to_accel

species:
  - O: { mass: 15.999 Da, z: 8, charge: 0 e- }
  - H: { mass: 1.008 Da, z: 1, charge: 0 e- }

init_parameters:
  - species
  - deepmd_init:
      parameters: { file: "water_se_atten_v2.dpnative.yaml" }

compute_force:
  - deepmd_force

setup_system:
  - domain:
      cell_size: 3.2 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: "water192_gen.xyz"
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 2.5e-4 ps
