# no-seq no-mt no-mpi : tabpair, two species, multi_force
# disabled (no-seq no-mt no-mpi) : tabpair_multi_force explodes (kinetic energy ~1e34 after 10 steps) with the same table/lattice that is stable with tabpair_compute_force, to investigate
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }

tabpair_multi_force:
  rcut: 5.68 ang
  common_parameters: { file: "lj_tab.yml" }
  parameters:
    - { type_a: Zn , type_b: Zn , rcut: 5.68 ang , parameters: { file: "lj_tab.yml" } }
    - { type_a: Cu , type_b: Zn , rcut: 5.68 ang , parameters: { file: "lj_tab.yml" } }

compute_force: tabpair_multi_force

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0, Zn: 1 }
  - particle_type_add_properties:
      Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
      Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - domain:
      cell_size: 8 ang
      grid_dims: [5,5,5]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Zn, Cu, Zn ]
      size: [ 5.0 ang , 5.0 ang , 5.0 ang ]   # nearest neighbours well inside the lj_tab.yml table
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
