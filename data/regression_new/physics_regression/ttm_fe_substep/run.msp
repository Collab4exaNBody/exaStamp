# Two-temperature model, Fe (EAM): 8 Te subcells per grid cell, the explicit-diffusion stability limit splits each
# step into inner diffusion steps (ghost Te exchanged between them)
includes:
  - ../common.yaml

species:
  - Fe: { mass: 55.845 Da , z: 26 , charge: 0.0 e- }

eam_alloy_force:
  rcut: 4.1615 ang
  parameters:
    file: "Fe_Olsson_CMS2009.eam.alloy"

compute_force:
  - eam_alloy_force
  # the Langevin coupling also runs over ghost particles: their velocities must be fresh
  - ghost_update_r_v
  - ionic_eletronic_heat_transfer:
      gamma_p: 29.5917 Da/ps
      gamma_s: 47.5679 Da/ps
      v_0: 3.0 ang/ps        # low threshold: the stopping term acts on part of the particles
      Ke: 0.005365 eV/ps/ang/K
      Ce: 1.2470e-5 eV/K
      rho_e: 0.087614 1/ang^3
      splat_size: 0.1 ang
      grid_subdiv: 2
      ti_source: "null"
      te_source: "null"
      substep_diffusion: true

setup_system:
  - domain:
      cell_size: 5.71 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 57.1 ang, 57.1 ang, 57.1 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Fe, Fe ]
      size: [ 2.855 ang, 2.855 ang, 2.855 ang ]
      shift: [ 0.01 ang, 0.01 ang, 0.01 ang ]
  - physics_regression_noise
  - resize_grid_cell_values
  - init_ttm:
      grid_subdiv: 2
      ti_source: "null"
      te_source:
        # Te(x) = 35.026*x + 1000 K: 1000 K -> 3000 K along x
        wavefront:
          plane: [ 35.026, 0.0, 0.0, 1000.0 ]
          wave: [ 0.0, 1.0, 0.0, 0.0 ]
          amplitude: 0.0
+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
