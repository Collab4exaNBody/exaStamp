# Rigid H2O molecules (4 sites O, H, H, M), yukawa_rigidmol_force
includes:
  - ../common.yaml
  - config_rigid_molecule.msp

grid_flavor: grid_flavor_rigidmol

yukawa_rigidmol_force:
  rcut: 8 ang
  parameters:
    - { type_a: O , type_b: O , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }
    - { type_a: O , type_b: M , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }
    - { type_a: O , type_b: H , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }
    - { type_a: H , type_b: M , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }
    - { type_a: M , type_b: M , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }
    - { type_a: H , type_b: H , rcut: 8 ang , parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang } }

compute_force:
  - yukawa_rigidmol_force

generate_h2o:
  - species:
      verbose: false
      species:
        - H: { mass: 1.007 Da, z: 1, charge: 0.5564 e-, molecule: H2O }
        - O: { mass: 16 Da, z: 8, charge: 0.0 e-, molecule: H2O }
        - M: { mass: 0.000 Da, z: 0, charge: -1.1128 e-, molecule: H2O }
        - H2O:
            charge: 0.0 e-
            z: 0
            mass: 0.0 Da
            rigid_molecule:
              - O: [ 0.00000000 ang, 0.00000000 ang, 0.00000000 ang ]
              - H: [ 0.75695033 ang, 0.58588228 ang, 0.00000000 ang ]
              - H: [ -0.75695033 ang, 0.58588228 ang, 0.00000000 ang ]
              - M: [ 0.00000000 ang, 0.15460000 ang, 0.00000000 ang ]
  - lattice:
      structure: SC
      types: [ H2O ]
      size: [ 3.0 ang, 3.0 ang, 3.0 ang ]

setup_system:
  - domain:
      cell_size: 15. ang
      grid_dims: [ 2, 2, 2 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 30 ang, 30 ang, 30 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
  - init_rcb_grid
  - generate_h2o
  - physics_regression_noise
  - random_orient

init_epilog:
  - init_mass_center
  - init_rigid_mol_inertial_mass

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
