# REBO C-H (rebo_manybody_mixedprec), hydrocarbon configuration CH216 replicated 2x2x2
includes:
  - ../common.yaml

species:
  - C: { z: 12, mass: 12.0107 Da, charge: 0.0 e- }
  - H: { z: 1, mass: 1.00794 Da, charge: 0.0 e- }

init_parameters:
  - species
  - rebo_init:
      parameters:
        potential_file: "CH.rebo"

compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force:
  - rebo_bond_order
  - ghost_update_opt: { opt_fields: [ "NijC", "NijH" ] }
  - rebo_conjugation
  - ghost_update_opt: { opt_fields: [ "Nconj" ] }
  - rebo_pairwise_nobuffer
  - rebo_manybody_mixedprec

compute_force_epilog:
  - update_force_from_ghost
  - force_to_accel

setup_system:
  - domain:
      cell_size: 10.0 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: CH216.xyz
  - replicate_domain: [ 2, 2, 2 ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 0.125e-3 ps
  # single precision bond-angle spline (references made on GPU). Measured spread vs references (L2, thermo max rel.):
  # CPU (arm64 GCC) seq/mt/par: pos 8.2e-8, vel 1.2e-4, acc 0.27, thermo 3.0e-9 ; same with -ffp-contract=off:
  # pos 2.6e-7, vel 3.8e-4, acc 0.87, thermo 7.7e-9. rebo_manybody (double) differs from these references by
  # pos 1.6e-6, vel 2.5e-3, acc 2.2, thermo 2.9e-7: the thresholds still tell the two precisions apart
  pr_pos_threshold: 8.e-7
  pr_vel_threshold: 1.2e-3
  pr_acc_threshold: 1.5
  pr_thermo_threshold: 3.e-8
