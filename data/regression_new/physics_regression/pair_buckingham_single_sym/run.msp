# no-mpi : buckingham, single species, symmetric computation
# disabled (no-mpi) : race in symmetric pair kernels with MPI + OpenMP threads (4 ranks x 4 threads): per-atom forces differ run to run, CPU and GPU; 4x1 and 1x4 are exact -> to fix in the code
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - C: { mass: 12.011 Da , z: 6 , charge: 0.0 e- }

buckingham_compute_force_symetric:
  rcut: 5.0 ang
  parameters: { A: 3.2 eV , Rho: 0.4 ang , C: 0.2 eV*ang^6 }

compute_force: buckingham_compute_force_symetric

setup_system:
  - particle_types:
      particle_type_map: { C: 0 }
  - particle_type_add_properties:
      C: { mass: 12.011 Da , z: 6 , charge: 0.0 e- }
  - domain:
      cell_size: 8 ang
      grid_dims: [5,5,5]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: SC
      types: [ C ]
      size: [ 2.5 ang , 2.5 ang , 2.5 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
