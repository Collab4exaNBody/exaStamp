# no-mpi : yukawa, single species, symmetric computation
# disabled (no-mpi) : race in symmetric pair kernels with MPI + OpenMP threads (4 ranks x 4 threads): per-atom forces differ run to run, CPU and GPU; 4x1 and 1x4 are exact -> to fix in the code
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Fe: { mass: 55.845 Da , z: 26 , charge: 0.0 e- }

write_snapshot:
  - timestep_file: "yukawa_%09d.xyz"
  - write_xyz:
      fields: [ id, type ]

yukawa_compute_force_symetric:
  parameters: { A: 2.43 eV*ang , kappa: 4.1 1/ang }  
  rcut: 8.0 ang

compute_force: yukawa_compute_force_symetric

setup_system:
  - particle_types:
      particle_type_map: { Fe: 0 }
  - particle_type_add_properties:
      Fe: { mass: 55.845 Da , z: 26 , charge: 0.0 e- }
  - domain:
      cell_size: 5 ang
      grid_dims: [10,10,10]
      bounds: [[0 ang ,0 ang,0 ang],[50. ang, 50. ang, 50. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: SC
      types: [ Fe ]
      size: [ 3.0 ang , 3.0 ang , 3.0 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
