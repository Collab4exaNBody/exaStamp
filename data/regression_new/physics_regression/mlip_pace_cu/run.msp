# PACE Cu (recursive evaluator)
includes:
  - ../common.yaml

compute_force_prolog:
  - zero_force_energy: { ghost: true }

compute_force_epilog:
  - update_force_energy_from_ghost
  - force_to_accel

species:
  - Cu: { mass: 63.546 Da, z: 29, charge: 0 e- }

init_parameters:
  - species
  - pace_init:
      parameters:
        coef: "Cu-PBE-core-rep.ace"
        algorithm: "recursive"

compute_force:
  - pace_force

setup_system:
  - domain:
      cell_size: 7.23 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 36.1500 ang, 36.1500 ang, 36.1500 ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Cu, Cu, Cu ]
      size: [ 3.615 ang, 3.615 ang, 3.615 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
  pr_acc_threshold: 1.e-8   # PACE: thread-order summation spread ~6e-10 on accelerations
