# coul_cut, two species, multi_force
# generated from potentials/pair inputs, references in ref_values.dat / ref_thermo.yaml
includes:
  - ../common.yaml

grid_flavor: grid_flavor_multimat

species:
  - Zn: { mass: 65.38 Da , z: 30 , charge: 0.4 e- }
  - Cu: { mass: 63.546 Da , z: 29 , charge: -0.4 e- }

coul_cut_multi_force:
  rcut: 8. ang
  common_parameters: { dielectric: 1.0, shift: true }
  parameters:
    - { type_a: Zn , type_b: Zn , rcut: 6.10 ang , parameters: { dielectric: 1.0, shift: true } }
    - { type_a: Cu , type_b: Zn , rcut: 5.89 ang , parameters: { dielectric: 0.5, shift: true } }

compute_force: coul_cut_multi_force

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0, Zn: 1 }
  - particle_type_add_properties:
      Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }
      Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - domain:
      cell_size: 8 ang
      grid_dims: [5,5,5]
      bounds: [[0 ang ,0 ang,0 ang],[40. ang, 40. ang, 40. ang]]
      xform: [[1.,0.,0.],[0.,1.,0.],[0.,0.,1.]]
      periodic: [true,true,true]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Zn, Cu, Zn ]
      size: [ 4.0 ang , 4.0 ang , 4.0 ang ]
  - physics_regression_noise

+global:
  rcut_inc: 1.0 ang
  dt: 1.0e-3 ps
