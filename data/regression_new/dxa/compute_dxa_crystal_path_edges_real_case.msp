species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

chunk_neighbors:
  config:
    chunk_size: 1
    build_particle_offset: true

setup_system:
  - domain:
      cell_size: 10 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_extended_xyz_file:
      filename: "quadrupole_dislo.xyz"
      bounds_mode: FILE

global:
  max_iteration: 0
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps
  rcut_max: 6.0 ang

simulation_epilog:
  - compute_dxa_lattice_correspondence: { rcut: 5.0 ang }
  - compute_dxa_lattice_clusters: {}
  - compute_delaunay
  - compute_dxa_crystal_path_edge_vectors: { crystal_path_steps: 4 }
  - dxa_print_n_matched: { rebind: { value: n_matched }, body: [print_int: { suffix: "\n" }] }
  - dxa_print_n_clusters: { rebind: { value: n_clusters }, body: [print_int: { suffix: "\n" }] }
  - dxa_print_n_transitions: { rebind: { value: n_transitions }, body: [print_int: { suffix: "\n" }] }
  - dxa_print_n_edges_resolved: { rebind: { value: n_edges_resolved }, body: [print_int: { suffix: "\n" }] }
