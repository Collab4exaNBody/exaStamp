species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

chunk_neighbors:
  config:
    chunk_size: 1
    build_particle_offset: true

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]

global:
  max_iteration: 0
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps
  rcut_max: 6.0 ang

simulation_epilog:
  - compute_dxa_lattice_correspondence: { rcut: 5.0 ang }
  - compute_dxa_lattice_clusters: {}
  - compute_delaunay: {}
  - compute_dxa_crystal_path_edge_vectors: { crystal_path_steps: 4 }
  - compute_dxa_elastic_mapping_tet_classification: {}
  - compute_dxa_elastic_interface_mesh: {}
  - write_interface_mesh: { filename: "paraview/elastic_interface" }
  - dxa_print_n_tets_good: { rebind: { value: n_tets_good }, body: [print_int: { suffix: "\n" }] }
  - dxa_print_n_interface_triangles: { rebind: { value: n_interface_triangles }, body: [print_int: { suffix: "\n" }] }
  - dxa_print_n_interface_cutoff_edges: { rebind: { value: n_interface_cutoff_edges }, body: [print_int: { suffix: "\n" }] }
