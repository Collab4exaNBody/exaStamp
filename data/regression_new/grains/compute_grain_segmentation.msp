# Input final_large.xyz is not stored in the repository, generate it first with Atomsk
# (24 random grains in a 200 ang box, about 445k atoms). -wrap puts all atoms back in the box,
# and the second line writes the extended XYZ header that read_extended_xyz_file needs
# (Atomsk writes a plain XYZ comment line in --polycrystal mode):
#   atomsk --polycrystal tantalum.xsf polycrystal.txt -wrap final_large.xyz
#   sed -i.bak '2s/.*/Lattice="200 0 0 0 200 0 0 0 200" Properties=species:S:1:pos:R:3/' final_large.xyz
# Atomsk keeps overlapping atom pairs at the grain boundaries (about 1% of the atoms closer than
# 1.5 ang): remove_close_particles deletes one atom of each pair before the analysis.

species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

compute_force: nop

chunk_neighbors:
  config:
    chunk_size: 1
    build_particle_offset: true

setup_system:
  - domain:
      cell_size: 20 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_extended_xyz_file:
      filename: "final_large.xyz"
      bounds_mode: FILE
      
global:
  max_iteration: 0
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_max: 8.0 ang
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps

compute_ptm:
  rcut: 6.0 ang
  rmsd_cutoff: 0.5

ptm_fields:
  struct_field: ptm_type
  orient_field: ptm_orientation
  rmsd_field: ptm_rmsd

compute_grain_bond_misorientation:
  rcut: 6.0 ang

compute_grain_clusters:
  min_grain_atom_count: 100
  orphan_adoption: true
  grains_file: grains.csv          # per-grain table: atoms, structure, mean orientation, color

simulation_epilog:
  - remove_close_particles: { distance: 1.5 ang, seed: 42 }
  - parallel_update_particles   # rebuild ghosts and neighbor lists after the removal
  - compute_ptm
  - ptm_fields
  - ghost_update_opt: { opt_fields: [ ptm_type, ptm_orientation ] }
  - compute_grain_bond_misorientation
  - compute_grain_clusters
  - timestep_file: "result_polycrystal_large.xyz"
  - write_xyz: { fields: [ id, type, ptm_type, grain_id ] }
