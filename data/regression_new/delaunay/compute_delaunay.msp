species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_r: { sigma: 0.05 ang }
    
global:
  max_iteration: 20
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_inc: 1.0 ang
  rcut_max: 8.0 ang
  dt: 5.0e-3 ps

write_snapshot:
  - compute_delaunay
  - timestep_file: "xyz/current_config_%09d.xyz"
  - write_xyz: { fields: [ id, type ] }
  - timestep_file: "paraview/delaunay_%09d"
  - write_delaunay_vtk

  
