species:
  - Ta: { mass: 180.95 Da, z: 73, charge: 0 e- }

compute_force: nop

chunk_neighbors:
  config:
    chunk_size: 1
    build_particle_offset: true

setup_system:
  - domain:
      cell_size: 6.6 ang
      grid_dims: [ 10, 10, 10 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66. ang, 66. ang, 66. ang ] ]
      xform: [ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3 ang, 3.3 ang, 3.3 ang ]
  - gaussian_noise_r:
      sigma: 0.05 ang

global:
  max_iteration: 0
  simulation_thermostate_screen_frequency: 10
  simulation_thermostate_file_frequency: -1
  simulation_snapshot_frequency: 10
  rcut_max: 8.0 ang
  rcut_inc: 1.0 ang
  dt: 5.0e-3 ps

compute_ptm:
  rcut: 6.0 ang
  rmsd_cutoff: 0.2
  
simulation_epilog:
  - compute_ptm
  - ptm_fields:
      struct_field: ptm_type
      orient_field: ptm_orientation
      rmsd_field: ptm_rmsd
  - ghost_update_opt: { opt_fields: [ "ptm_type", "ptm_rmsd" ] }
  - compute_delaunay
  - write_delaunay_vtk: { filename: "paraview/delaunay_ptm_color", color_fields: [ ptm_type, ptm_rmsd ] }
  - timestep_file: "bcc_sample.xyz"
  - write_xyz: { fields: [ id, type, ptm_type ] }
