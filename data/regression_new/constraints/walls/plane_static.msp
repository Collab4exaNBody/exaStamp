includes:
  - baseline_plane.yaml
  - snapshot.yaml

left_wall:
  - plane_wall:
      normal: [ 1.0, 0.0, 0.0 ]
      offset: 17.0 ang # positionned at the limit of the domain
      cutoff: 2.2 ang
      epsilon: 1.0e-19 J

right_wall:
  - plane_wall:
      normal: [ -1, 0.0, 0.0 ]
      offset: 200.0 ang # positionned at the limit of the domain
      cutoff: 2.2 ang
      epsilon: 1.0e-19 J

+compute_force:
  - left_wall
  - right_wall
