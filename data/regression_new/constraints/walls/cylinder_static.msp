includes:
  - baseline_cylinder.yaml
  - snapshot.yaml

confinement_wall:
  - cylinder_wall:
      origin: [ 50.0 ang, 50.0 ang, 50.0 ang ] # any point on the axis
      axis: [ 1.0, 0.0, 0.0 ]
      radius: 45.0 ang
      cutoff: 2.2 ang
      epsilon: 1.0e-19 J

+compute_force:
  - confinement_wall
