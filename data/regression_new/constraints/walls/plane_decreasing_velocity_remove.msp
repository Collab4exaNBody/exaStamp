includes:
  - baseline_plane.yaml
  - snapshot.yaml

left_wall:
  - move_plane_wall:
      csv_filename: "plane_decreasing_velocity_remove.csv"
      csv_separator: " "
      init_normal: [ 1.0, 0.0, 0.0 ]
      init_offset: 15.0 ang
      init_cutoff: 2.2 ang
      init_epsilon: 1.0e-19 J
      init_time: 0.5 ps
      init_velocity: 3000 m/s
      final_time: 5.0 ps
      final_velocity: 100 m/s
  - plane_wall

+compute_force:
  - left_wall
