# Cu FCC NVE, histogram of the x velocities written at the end of the run
species:
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0 e- }

eam_alloy_force:
  rcut: 5.50679 ang
  parameters:
    file: Cu.eam.alloy
compute_force: [ eam_alloy_force ]

setup_system:
  - domain:
      cell_size: 7.23 ang
      grid_dims: [ 5, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 36.15 ang, 36.15 ang, 36.15 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Cu, Cu, Cu ]
      size: [ 3.615 ang, 3.615 ang, 3.615 ang ]
      shift: [ 0.003615 ang, 0.003615 ang, 0.003615 ang ]
  - init_temperature_new:
      T: 600 K

numerical_scheme: verlet_nve

simulation_epilog:
  - histogram_vx: { samples: 100 }
  - write_histogram: { filename: vx_hist.csv }

global:
  max_iteration: 1000
  dt: 1.0e-3 ps
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
