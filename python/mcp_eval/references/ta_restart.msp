# Continue a Ta run from a restart file written by write_dump_atoms
species:
  - Ta: { mass: 180.948 Da , z: 73 , charge: 0 e- }

eam_alloy_force:
  rcut: 5.3 ang
  parameters:
    file: Ta1_Ravelo_2013.eam.alloy
compute_force: [ eam_alloy_force ]

setup_system:
  - read_dump_atoms:
      filename: ta_restart.MpiIO

numerical_scheme: verlet_lnvt
langevin_thermostat:
  T: 300 K
  gamma: 0.1 ps^-1

write_restart: write_restart_atoms

global:
  max_iteration: 2500
  dt: 1.0e-3 ps
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
  simulation_restart_frequency: 500
