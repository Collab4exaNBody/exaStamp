# Ta BCC, NVE everywhere except a Langevin heat bath on the slab x < 10 A
species:
  - Ta: { mass: 180.948 Da , z: 73 , charge: 0 e- }

eam_alloy_force:
  rcut: 5.3 ang
  parameters:
    file: Ta1_Ravelo_2013.eam.alloy
compute_force:
  - eam_alloy_force
  - langevin_thermostat:
      T: 300 K
      gamma: 0.1 ps^-1
      thermostat_region: BATH

setup_system:
  - particle_regions:
      - BATH:
          bounds: [ [ 0 ang, -1 ang, -1 ang ], [ 10 ang, 34 ang, 34 ang ] ]
  - domain:
      cell_size: 6.6052 ang
      grid_dims: [ 10, 5, 5 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 66.052 ang, 33.026 ang, 33.026 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: BCC
      types: [ Ta, Ta ]
      size: [ 3.3026 ang, 3.3026 ang, 3.3026 ang ]
      shift: [ 0.003303 ang, 0.003303 ang, 0.003303 ang ]

numerical_scheme: verlet_nve

global:
  max_iteration: 2000
  dt: 1.0e-3 ps
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
