# Stillinger-Weber silicon read from an extended XYZ file (cell and velocities in the file)
species:
  - Si: { mass: 28.0855 Da , z: 14 , charge: 0.0 e- }

init_parameters:
  - species
  - sw_init:
      parameters: { file: Si.sw }

compute_force:
  - sw_force

grid_flavor: grid_flavor_full

setup_system:
  - domain:
      cell_size: 5.431 ang
      periodic: [ true, true, true ]
      expandable: false
  - read_xyz_file_with_xform:
      filename: init.xyz
      bounds_mode: FILE
      read_velocities: true

numerical_scheme: verlet_nve

global:
  max_iteration: 1000
  dt: 1.0e-3 ps
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
