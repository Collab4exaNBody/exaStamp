# Rigid TIP4P-like water, 216 molecules on a simple cubic start, LJ + reaction field, Langevin 300 K
includes:
  - config_rigid_molecule.msp

# Lennard-Jones + Reaction Field combined potential
ljrf_rigidmol_force:
  rcut: 8 ang
  parameters:
    - {
        type_a: O,
        type_b: O,
        rcut: 8 ang,
        parameters:
          {
            rf: { epsilon: 100, rc: 8 ang },
            lj_rcut: 8 ang,
            lj: { epsilon: 1.286776984E-21 J, sigma: 0.31589E-09 m },
          },
      }
    - {
        type_a: O,
        type_b: M,
        rcut: 8 ang,
        parameters: { rf: { epsilon: 100, rc: 8 ang } },
      }
    - {
        type_a: O,
        type_b: H,
        rcut: 8 ang,
        parameters: { rf: { epsilon: 100, rc: 8 ang } },
      }
    - {
        type_a: H,
        type_b: M,
        rcut: 8 ang,
        parameters: { rf: { epsilon: 100, rc: 8 ang } },
      }
    - {
        type_a: M,
        type_b: M,
        rcut: 8 ang,
        parameters: { rf: { epsilon: 100, rc: 8 ang } },
      }
    - {
        type_a: H,
        type_b: H,
        rcut: 8 ang,
        parameters: { rf: { epsilon: 100, rc: 8 ang } },
      }

compute_force:
  - ljrf_rigidmol_force
  - langevin_thermostat_rigidmol:
      T: 300 K
      gamma: 1.0 ps^-1

grid_flavor: grid_flavor_rigidmol

generate_H2O_rigidmol_sample:
  - species:
      verbose: false
      species:
        - H: { mass: 1.007 Da, z: 1, charge: 0.5564 e-, molecule: H2O }
        - O: { mass: 16 Da, z: 8, charge: 0.0 e-, molecule: H2O }
        - M: { mass: 0.000 Da, z: 0, charge: -1.1128 e-, molecule: H2O }
        - H2O:
            charge: 0.0 e-
            z: 0
            mass: 0.0 Da
            rigid_molecule:
              - O: [ 0.00000000 ang, 0.00000000 ang, 0.00000000 ang ]
              - H: [ 0.75695033 ang, 0.58588228 ang, 0.00000000 ang ]
              - H: [ -0.75695033 ang, 0.58588228 ang, 0.00000000 ang ]
              - M: [ 0.00000000 ang, 0.15460000 ang, 0.00000000 ang ]
  - lattice:
      structure: SC
      types: [ H2O ]
      size: [ 3.1 ang, 3.1 ang, 3.1 ang ]
      shift: [ 0.0031 ang, 0.0031 ang, 0.0031 ang ]

setup_system:
  - domain:
      cell_size: 9.3 ang
      grid_dims: [ 2, 2, 2 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 18.6 ang, 18.6 ang, 18.6 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - generate_H2O_rigidmol_sample
  - random_orient

init_epilog:
  - init_mass_center
  - init_rigid_mol_inertial_mass
  - init_temperature_rigidmol: { T: 300 K }

write_snapshot: nop

global:
  dt: 1.0e-3 ps
  max_iteration: 1000
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
  simulation_restart_frequency: -1
