# Cu-Zn on an FCC lattice, one Lennard-Jones potential per species pair
species:
  - Cu: { mass: 63.546 Da , z: 29 , charge: 0.0 e- }
  - Zn: { mass: 65.38 Da , z: 30 , charge: 0.0 e- }

grid_flavor: grid_flavor_multimat

compute_force_pair_multimat:
  potentials:
    - { type_a: Cu , type_b: Cu , potential: lj , rcut: 6.0 ang , parameters: { epsilon: 0.4093 eV , sigma: 2.338 ang } }
    - { type_a: Zn , type_b: Zn , potential: lj , rcut: 6.0 ang , parameters: { epsilon: 0.1574 eV , sigma: 2.44 ang } }
    - { type_a: Cu , type_b: Zn , potential: lj , rcut: 6.0 ang , parameters: { epsilon: 0.30 eV , sigma: 2.36 ang } }

compute_force: compute_force_pair_multimat

setup_system:
  - particle_types:
      particle_type_map: { Cu: 0, Zn: 1 }
  - domain:
      cell_size: 7.4 ang
      grid_dims: [ 4, 4, 4 ]
      bounds: [ [ 0 ang, 0 ang, 0 ang ], [ 29.6 ang, 29.6 ang, 29.6 ang ] ]
      periodic: [ true, true, true ]
      expandable: false
  - init_rcb_grid
  - lattice:
      structure: FCC
      types: [ Cu, Zn, Cu, Zn ]
      size: [ 3.7 ang, 3.7 ang, 3.7 ang ]
      shift: [ 0.0037 ang, 0.0037 ang, 0.0037 ang ]
  - init_temperature_new:
      T: 300 K

numerical_scheme: verlet_nve

global:
  max_iteration: 500
  dt: 1.0e-3 ps
  rcut_inc: 1.0 ang
  simulation_thermostate_screen_frequency: 10
  simulation_snapshot_frequency: -1
